<?xml version="1.0" encoding="UTF-8"?>

<behavior name="Acquire_Everything">

	<executable package_path="acquisition_fb_flexbe_behaviors.acquire_everything_sm" class="Acquire_EverythingSM" />
	<tagstring>acquisition, tmux, sound, old_heading, upright, ar</tagstring>
	<author>frekle</author>
	<date>Wed Oct 23 2024</date>
	<description>
		acquire using embeddable IMU behavior
- with tmux 
- IMUs with upright start
- IK using old heading 
- playing sounds
- now tries to add camera as well
- adds rqt_acquisition
	</description>


	<!-- Contained Behaviors -->
	<contains name="imu_startup_sequence" />
	<contains name="ar_brio" />
	<contains name="urdf_simple_scaling" />

	<!-- Available Parameters -->
	<params>

		<param type="boolean" name="run_insoles" default="True" label="run_insoles" hint="Sets the run_insoles" />

		<param type="boolean" name="run_id" default="True" label="run_id" hint="Sets the run_id" />

		<param type="boolean" name="run_so" default="True" label="run_so" hint="Sets the run_so" />

		<param type="boolean" name="run_vicon_controller" default="True" label="run_vicon_controller" hint="Sets the run_vicon_controller" />

		<param type="text" name="remove_path" default="/srv/host_data" label="remove_path" hint="Sets the prefix to be removed from the save path" />

		<param type="text" name="append_path" default="d:/ViconData" label="append_path" hint="Sets the append_path" />

		<param type="text" name="vicon_ip" default="192.168.1.103" label="vicon_ip" hint="Sets the vicon_ip" />

		<param type="numeric" name="vicon_port" default="1030" label="vicon_port" hint="Sets the vicon_port">
			<min value="0" />
			<max value="70000" />
		</param>

		<param type="text" name="session_id" default="SESSION1" label="session_id" hint="Sets the session_id" />

		<param type="text" name="activity_name" default="test1" label="activity_name" hint="Sets the activity_name" />

		<param type="text" name="subject_id" default="EXS2" label="subject_id" hint="Sets the subject_id" />

		<param type="numeric" name="weight" default="70" label="weight [kg]" hint="Sets the weight">
			<min value="0" />
			<max value="1000" />
		</param>

		<param type="numeric" name="height" default="1.70" label="height [m]" hint="Sets the height">
			<min value="0" />
			<max value="3" />
		</param>

		<param type="enum" name="insole_size" default="S6 (42-43)" label="insole_size" hint="Sets the insole_size">
			<option value="S3 (36-37)" />
			<option value="S4 (38-39)" />
			<option value="S6 (42-43)" />
		</param>

		<param type="boolean" name="combined_acquisition" default="True" label="combined_acquisition" hint="Sets the combined_acquisition" />

		<param type="boolean" name="use_ar_markers_in_ik" default="False" label="use_ar_markers_in_ik" hint="Sets the use_ar_markers_in_ik" />

		<param type="boolean" name="show_viz_extensive" default="False" label="show_viz_extensive" hint="Sets the show_viz_extensive" />

		<param type="boolean" name="record_rosbag" default="False" label="record_rosbag" hint="Sets the record_rosbag" />

		<param type="boolean" name="dummy_insoles" default="True" label="dummy_insoles" hint="Sets the dummy_insoles" />

	</params>


</behavior>